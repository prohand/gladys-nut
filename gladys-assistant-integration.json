{
  "manifest_version": 1,
  "type": "device",
  "name": "Network UPS Tools (NUT)",
  "description": {
    "en": "Monitor the status, load and battery runtime of the UPS devices on your NUT servers.",
    "fr": "Suivez l’état, la charge et l’autonomie des onduleurs de vos serveurs Network UPS Tools.",
    "de": "Überwache Status, Last und Restlaufzeit der USV-Geräte deiner NUT-Server.",
    "es": "Supervise el estado, la carga y la autonomía de los SAI de sus servidores NUT."
  },
  "version": "2.3.1",
  "docker_image": "ghcr.io/prohand/gladys-nut:2.3.1",
  "gladys_version": ">=5.3.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-nut/v2.3.1/cover.jpg",
  "categories": ["servers", "energy", "network"],
  "keywords": [
    "onduleur",
    "usv",
    "sai",
    "upsd",
    "eaton",
    "apc",
    "cyberpower",
    "power outage",
    "battery backup",
    "nobreak"
  ],
  "transports": ["local"],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "NUT servers",
        "fr": "Serveurs NUT",
        "de": "NUT-Server",
        "es": "Servidores NUT"
      },
      "description": {
        "en": "Configure one or more reachable upsd servers. Every UPS exposed by every configured server is discovered as a separate Gladys device.",
        "fr": "Configurez un ou plusieurs serveurs upsd accessibles. Chaque onduleur exposé par chaque serveur configuré est découvert comme un appareil Gladys distinct.",
        "de": "Konfiguriere einen oder mehrere erreichbare upsd-Server. Jede USV, die ein konfigurierter Server bereitstellt, wird als eigenes Gladys-Gerät erkannt.",
        "es": "Configure uno o varios servidores upsd accesibles. Cada SAI expuesto por cada servidor configurado se detecta como un dispositivo Gladys independiente."
      },
      "links": [
        {
          "url": "https://networkupstools.org/docs/developer-guide.chunked/net-protocol.html",
          "label": {
            "en": "NUT network protocol",
            "fr": "Protocole réseau NUT",
            "de": "NUT-Netzwerkprotokoll",
            "es": "Protocolo de red NUT"
          }
        }
      ]
    },
    {
      "key": "server_1_host",
      "type": "string",
      "label": {
        "en": "Server 1 host",
        "fr": "Hôte du serveur 1",
        "de": "Host von Server 1",
        "es": "Host del servidor 1"
      },
      "description": {
        "en": "IP address or DNS name of the first NUT upsd server.",
        "fr": "Adresse IP ou nom DNS du premier serveur NUT upsd.",
