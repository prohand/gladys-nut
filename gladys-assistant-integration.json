        "es": "Dirección IP o nombre DNS del primer servidor NUT upsd."
      },
      "placeholder": {
        "en": "192.168.1.20",
        "fr": "192.168.1.20",
        "de": "192.168.1.20",
        "es": "192.168.1.20"
      },
      "required": true
    },
    {
      "key": "server_1_port",
      "type": "number",
      "label": {
        "en": "Server 1 port",
        "fr": "Port du serveur 1",
        "de": "Port von Server 1",
        "es": "Puerto del servidor 1"
