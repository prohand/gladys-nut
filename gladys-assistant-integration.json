{
  "manifest_version": 1,
  "type": "device",
  "name": "Network UPS Tools (NUT)",
  "description": {
    "en": "Monitor the status, load and battery runtime of the UPS devices on your NUT servers.",
    "fr": "Suivez l’état, la charge et l’autonomie des onduleurs de vos serveurs Network UPS Tools."
  },
  "version": "1.0.6",
  "docker_image": "ghcr.io/prohand/gladys-nut:1.0.6",
  "gladys_version": ">=4.86.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-nut/main/cover.jpg",
  "categories": [
    "energy",
    "network"
  ],
  "transports": [
    "local"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "NUT servers",
        "fr": "Serveurs NUT"
      },
      "description": {
        "en": "Configure one or more reachable upsd servers. Every UPS exposed by every configured server is discovered as a separate Gladys device.",
        "fr": "Configurez un ou plusieurs serveurs upsd accessibles. Chaque onduleur exposé par chaque serveur configuré est découvert comme un appareil Gladys distinct."
      },
      "links": [
        {
          "url": "https://networkupstools.org/docs/developer-guide.chunked/net-protocol.html",
          "label": {
            "en": "NUT network protocol",
            "fr": "Protocole réseau NUT"
          }
        }
      ]
    },
    {
      "key": "server_1_host",
      "type": "string",
      "label": {
        "en": "Server 1 host",
        "fr": "Hôte du serveur 1"
      },
      "description": {
        "en": "IP address or DNS name of the first NUT upsd server.",
        "fr": "Adresse IP ou nom DNS du premier serveur NUT upsd."
      },
      "placeholder": {
        "en": "192.168.1.20",
        "fr": "192.168.1.20"
      },
      "required": true
    },
    {
      "key": "server_1_port",
      "type": "number",
      "label": {
        "en": "Server 1 port",
        "fr": "Port du serveur 1"
      },
      "description": {
        "en": "The default NUT TCP port is 3493.",
        "fr": "Le port TCP NUT par défaut est 3493."
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_1_username",
      "type": "string",
      "label": {
        "en": "Server 1 username (optional)",
        "fr": "Nom d’utilisateur du serveur 1 (facultatif)"
      },
      "required": false
    },
    {
      "key": "server_1_password",
      "type": "secret",
      "label": {
        "en": "Server 1 password (optional)",
        "fr": "Mot de passe du serveur 1 (facultatif)"
      },
      "description": {
        "en": "Required when a username is configured.",
        "fr": "Obligatoire lorsqu’un nom d’utilisateur est configuré."
      },
      "required": false
    },
    {
      "key": "server_2_host",
      "type": "string",
      "label": {
        "en": "Server 2 host (optional)",
        "fr": "Hôte du serveur 2 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.21",
        "fr": "192.168.1.21"
      },
      "required": false
    },
    {
      "key": "server_2_port",
      "type": "number",
      "label": {
        "en": "Server 2 port",
        "fr": "Port du serveur 2"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_2_username",
      "type": "string",
      "label": {
        "en": "Server 2 username",
        "fr": "Nom d’utilisateur du serveur 2"
      },
      "required": false
    },
    {
      "key": "server_2_password",
      "type": "secret",
      "label": {
        "en": "Server 2 password",
        "fr": "Mot de passe du serveur 2"
      },
      "required": false
    },
    {
      "key": "server_3_host",
      "type": "string",
      "label": {
        "en": "Server 3 host (optional)",
        "fr": "Hôte du serveur 3 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.22",
        "fr": "192.168.1.22"
      },
      "required": false
    },
    {
      "key": "server_3_port",
      "type": "number",
      "label": {
        "en": "Server 3 port",
        "fr": "Port du serveur 3"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_3_username",
      "type": "string",
      "label": {
        "en": "Server 3 username",
        "fr": "Nom d’utilisateur du serveur 3"
      },
      "required": false
    },
    {
      "key": "server_3_password",
      "type": "secret",
      "label": {
        "en": "Server 3 password",
        "fr": "Mot de passe du serveur 3"
      },
      "required": false
    },
    {
      "key": "server_4_host",
      "type": "string",
      "label": {
        "en": "Server 4 host (optional)",
        "fr": "Hôte du serveur 4 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.23",
        "fr": "192.168.1.23"
      },
      "required": false
    },
    {
      "key": "server_4_port",
      "type": "number",
      "label": {
        "en": "Server 4 port",
        "fr": "Port du serveur 4"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_4_username",
      "type": "string",
      "label": {
        "en": "Server 4 username",
        "fr": "Nom d’utilisateur du serveur 4"
      },
      "required": false
    },
    {
      "key": "server_4_password",
      "type": "secret",
      "label": {
        "en": "Server 4 password",
        "fr": "Mot de passe du serveur 4"
      },
      "required": false
    },
    {
      "key": "server_5_host",
      "type": "string",
      "label": {
        "en": "Server 5 host (optional)",
        "fr": "Hôte du serveur 5 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.24",
        "fr": "192.168.1.24"
      },
      "required": false
    },
    {
      "key": "server_5_port",
      "type": "number",
      "label": {
        "en": "Server 5 port",
        "fr": "Port du serveur 5"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_5_username",
      "type": "string",
      "label": {
        "en": "Server 5 username",
        "fr": "Nom d’utilisateur du serveur 5"
      },
      "required": false
    },
    {
      "key": "server_5_password",
      "type": "secret",
      "label": {
        "en": "Server 5 password",
        "fr": "Mot de passe du serveur 5"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often each UPS is queried. Gladys polls once a minute at most, so the interval is applied on the closest polling tick.",
        "fr": "Fréquence d’interrogation de chaque onduleur. Gladys interroge au maximum une fois par minute : l’intervalle est appliqué au tick de scrutation le plus proche."
      },
      "required": false,
      "default": 60,
      "min": 30,
      "max": 3600
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test NUT connections",
        "fr": "Tester les connexions NUT"
      },
      "timeout_seconds": 20
    }
  ]
}
