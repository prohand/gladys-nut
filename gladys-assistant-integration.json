{
  "manifest_version": 1,
  "type": "device",
  "name": "Network UPS Tools (NUT)",
  "description": {
    "en": "Monitor the status, load and battery runtime of the UPS devices on your NUT servers.",
    "fr": "Suivez l’état, la charge et l’autonomie des onduleurs de vos serveurs Network UPS Tools."
  },
  "version": "2.0.0",
  "docker_image": "ghcr.io/prohand/gladys-nut:2.0.0",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/prohand/gladys-nut/main/cover.jpg",
  "categories": [
    "energy",
    "network"
  ],
  "transports": [
    "local"
  ],
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": {
        "en": "NUT servers",
        "fr": "Serveurs NUT"
      },
      "description": {
        "en": "Configure one or more reachable upsd servers. Every UPS exposed by every configured server is discovered as a separate Gladys device.",
        "fr": "Configurez un ou plusieurs serveurs upsd accessibles. Chaque onduleur exposé par chaque serveur configuré est découvert comme un appareil Gladys distinct."
      },
      "links": [
        {
          "url": "https://networkupstools.org/docs/developer-guide.chunked/net-protocol.html",
          "label": {
            "en": "NUT network protocol",
            "fr": "Protocole réseau NUT"
          }
        }
      ]
    },
    {
      "key": "server_1_host",
      "type": "string",
      "label": {
        "en": "Server 1 host",
        "fr": "Hôte du serveur 1"
      },
      "description": {
        "en": "IP address or DNS name of the first NUT upsd server.",
        "fr": "Adresse IP ou nom DNS du premier serveur NUT upsd."
      },
      "placeholder": {
        "en": "192.168.1.20",
        "fr": "192.168.1.20"
      },
      "required": true
    },
    {
      "key": "server_1_port",
      "type": "number",
      "label": {
        "en": "Server 1 port",
        "fr": "Port du serveur 1"
      },
      "description": {
        "en": "The default NUT TCP port is 3493.",
        "fr": "Le port TCP NUT par défaut est 3493."
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_1_username",
      "type": "string",
      "label": {
        "en": "Server 1 username (optional)",
        "fr": "Nom d’utilisateur du serveur 1 (facultatif)"
      },
      "required": false
    },
    {
      "key": "server_1_password",
      "type": "secret",
      "label": {
        "en": "Server 1 password (optional)",
        "fr": "Mot de passe du serveur 1 (facultatif)"
      },
      "description": {
        "en": "Required when a username is configured.",
        "fr": "Obligatoire lorsqu’un nom d’utilisateur est configuré."
      },
      "required": false
    },
    {
      "key": "server_2_host",
      "type": "string",
      "label": {
        "en": "Server 2 host (optional)",
        "fr": "Hôte du serveur 2 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.21",
        "fr": "192.168.1.21"
      },
      "required": false
    },
    {
      "key": "server_2_port",
      "type": "number",
      "label": {
        "en": "Server 2 port",
        "fr": "Port du serveur 2"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_2_username",
      "type": "string",
      "label": {
        "en": "Server 2 username",
        "fr": "Nom d’utilisateur du serveur 2"
      },
      "required": false
    },
    {
      "key": "server_2_password",
      "type": "secret",
      "label": {
        "en": "Server 2 password",
        "fr": "Mot de passe du serveur 2"
      },
      "required": false
    },
    {
      "key": "server_3_host",
      "type": "string",
      "label": {
        "en": "Server 3 host (optional)",
        "fr": "Hôte du serveur 3 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.22",
        "fr": "192.168.1.22"
      },
      "required": false
    },
    {
      "key": "server_3_port",
      "type": "number",
      "label": {
        "en": "Server 3 port",
        "fr": "Port du serveur 3"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_3_username",
      "type": "string",
      "label": {
        "en": "Server 3 username",
        "fr": "Nom d’utilisateur du serveur 3"
      },
      "required": false
    },
    {
      "key": "server_3_password",
      "type": "secret",
      "label": {
        "en": "Server 3 password",
        "fr": "Mot de passe du serveur 3"
      },
      "required": false
    },
    {
      "key": "server_4_host",
      "type": "string",
      "label": {
        "en": "Server 4 host (optional)",
        "fr": "Hôte du serveur 4 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.23",
        "fr": "192.168.1.23"
      },
      "required": false
    },
    {
      "key": "server_4_port",
      "type": "number",
      "label": {
        "en": "Server 4 port",
        "fr": "Port du serveur 4"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_4_username",
      "type": "string",
      "label": {
        "en": "Server 4 username",
        "fr": "Nom d’utilisateur du serveur 4"
      },
      "required": false
    },
    {
      "key": "server_4_password",
      "type": "secret",
      "label": {
        "en": "Server 4 password",
        "fr": "Mot de passe du serveur 4"
      },
      "required": false
    },
    {
      "key": "server_5_host",
      "type": "string",
      "label": {
        "en": "Server 5 host (optional)",
        "fr": "Hôte du serveur 5 (facultatif)"
      },
      "placeholder": {
        "en": "192.168.1.24",
        "fr": "192.168.1.24"
      },
      "required": false
    },
    {
      "key": "server_5_port",
      "type": "number",
      "label": {
        "en": "Server 5 port",
        "fr": "Port du serveur 5"
      },
      "required": false,
      "default": 3493,
      "min": 1,
      "max": 65535
    },
    {
      "key": "server_5_username",
      "type": "string",
      "label": {
        "en": "Server 5 username",
        "fr": "Nom d’utilisateur du serveur 5"
      },
      "required": false
    },
    {
      "key": "server_5_password",
      "type": "secret",
      "label": {
        "en": "Server 5 password",
        "fr": "Mot de passe du serveur 5"
      },
      "required": false
    },
    {
      "key": "poll_frequency",
      "type": "number",
      "label": {
        "en": "Refresh interval (s)",
        "fr": "Intervalle de rafraîchissement (s)"
      },
      "description": {
        "en": "How often the readings are written to the Gladys history. Each one is a row in the database: keep 300 s unless you need finer measurements. The UPS status is still checked every minute for the scenes.",
        "fr": "Fréquence d’écriture des mesures dans l’historique Gladys. Chaque mesure est une ligne en base : gardez 300 s sauf besoin réel. L’état de l’onduleur reste vérifié chaque minute pour les scènes."
      },
      "required": false,
      "default": 300,
      "min": 60,
      "max": 86400
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": {
        "en": "Test NUT connections",
        "fr": "Tester les connexions NUT"
      },
      "timeout_seconds": 20
    }
  ],
  "widgets": [
    {
      "key": "ups",
      "label": {
        "en": "UPS",
        "fr": "Onduleur"
      },
      "icon": "battery-charging",
      "settings": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS",
            "fr": "Onduleur"
          },
          "required": true
        }
      ],
      "action_timeout_seconds": 20
    }
  ],
  "scene_triggers": [
    {
      "key": "power_lost",
      "label": {
        "en": "UPS: power failure, on battery",
        "fr": "Onduleur : coupure secteur, sur batterie"
      },
      "fields": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS (any when empty)",
            "fr": "Onduleur (tous si vide)"
          }
        }
      ],
      "variables": [
        {
          "key": "ups_name",
          "type": "string",
          "label": {
            "en": "UPS name",
            "fr": "Nom de l’onduleur"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "NUT status (ups.status)",
            "fr": "État NUT (ups.status)"
          }
        },
        {
          "key": "battery_charge",
          "type": "number",
          "label": {
            "en": "Battery charge (%)",
            "fr": "Charge de la batterie (%)"
          }
        },
        {
          "key": "battery_runtime",
          "type": "number",
          "label": {
            "en": "Battery runtime (min)",
            "fr": "Autonomie restante (min)"
          }
        },
        {
          "key": "load",
          "type": "number",
          "label": {
            "en": "Load (%)",
            "fr": "Charge de l’onduleur (%)"
          }
        }
      ]
    },
    {
      "key": "power_restored",
      "label": {
        "en": "UPS: power restored",
        "fr": "Onduleur : retour du secteur"
      },
      "fields": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS (any when empty)",
            "fr": "Onduleur (tous si vide)"
          }
        }
      ],
      "variables": [
        {
          "key": "ups_name",
          "type": "string",
          "label": {
            "en": "UPS name",
            "fr": "Nom de l’onduleur"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "NUT status (ups.status)",
            "fr": "État NUT (ups.status)"
          }
        },
        {
          "key": "battery_charge",
          "type": "number",
          "label": {
            "en": "Battery charge (%)",
            "fr": "Charge de la batterie (%)"
          }
        },
        {
          "key": "battery_runtime",
          "type": "number",
          "label": {
            "en": "Battery runtime (min)",
            "fr": "Autonomie restante (min)"
          }
        },
        {
          "key": "load",
          "type": "number",
          "label": {
            "en": "Load (%)",
            "fr": "Charge de l’onduleur (%)"
          }
        }
      ]
    },
    {
      "key": "battery_low",
      "label": {
        "en": "UPS: battery low",
        "fr": "Onduleur : batterie faible"
      },
      "fields": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS (any when empty)",
            "fr": "Onduleur (tous si vide)"
          }
        }
      ],
      "variables": [
        {
          "key": "ups_name",
          "type": "string",
          "label": {
            "en": "UPS name",
            "fr": "Nom de l’onduleur"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "NUT status (ups.status)",
            "fr": "État NUT (ups.status)"
          }
        },
        {
          "key": "battery_charge",
          "type": "number",
          "label": {
            "en": "Battery charge (%)",
            "fr": "Charge de la batterie (%)"
          }
        },
        {
          "key": "battery_runtime",
          "type": "number",
          "label": {
            "en": "Battery runtime (min)",
            "fr": "Autonomie restante (min)"
          }
        },
        {
          "key": "load",
          "type": "number",
          "label": {
            "en": "Load (%)",
            "fr": "Charge de l’onduleur (%)"
          }
        }
      ]
    },
    {
      "key": "battery_replace",
      "label": {
        "en": "UPS: battery to replace",
        "fr": "Onduleur : batterie à remplacer"
      },
      "fields": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS (any when empty)",
            "fr": "Onduleur (tous si vide)"
          }
        }
      ],
      "variables": [
        {
          "key": "ups_name",
          "type": "string",
          "label": {
            "en": "UPS name",
            "fr": "Nom de l’onduleur"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "NUT status (ups.status)",
            "fr": "État NUT (ups.status)"
          }
        },
        {
          "key": "battery_charge",
          "type": "number",
          "label": {
            "en": "Battery charge (%)",
            "fr": "Charge de la batterie (%)"
          }
        },
        {
          "key": "battery_runtime",
          "type": "number",
          "label": {
            "en": "Battery runtime (min)",
            "fr": "Autonomie restante (min)"
          }
        },
        {
          "key": "load",
          "type": "number",
          "label": {
            "en": "Load (%)",
            "fr": "Charge de l’onduleur (%)"
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_ups_status",
      "label": {
        "en": "Read a UPS status",
        "fr": "Lire l’état d’un onduleur"
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "ups",
          "type": "select",
          "source": "devices",
          "label": {
            "en": "UPS",
            "fr": "Onduleur"
          },
          "required": true
        }
      ],
      "outputs": [
        {
          "key": "ups_name",
          "type": "string",
          "label": {
            "en": "UPS name",
            "fr": "Nom de l’onduleur"
          }
        },
        {
          "key": "status",
          "type": "string",
          "label": {
            "en": "State (online, on_battery, low_battery…)",
            "fr": "État (online, on_battery, low_battery…)"
          }
        },
        {
          "key": "on_battery",
          "type": "boolean",
          "label": {
            "en": "On battery",
            "fr": "Sur batterie"
          }
        },
        {
          "key": "low_battery",
          "type": "boolean",
          "label": {
            "en": "Battery low",
            "fr": "Batterie faible"
          }
        },
        {
          "key": "replace_battery",
          "type": "boolean",
          "label": {
            "en": "Battery to replace",
            "fr": "Batterie à remplacer"
          }
        },
        {
          "key": "battery_charge",
          "type": "number",
          "label": {
            "en": "Battery charge (%)",
            "fr": "Charge de la batterie (%)"
          }
        },
        {
          "key": "battery_runtime",
          "type": "number",
          "label": {
            "en": "Battery runtime (min)",
            "fr": "Autonomie restante (min)"
          }
        },
        {
          "key": "load",
          "type": "number",
          "label": {
            "en": "Load (%)",
            "fr": "Charge de l’onduleur (%)"
          }
        },
        {
          "key": "input_voltage",
          "type": "number",
          "label": {
            "en": "Input voltage (V)",
            "fr": "Tension d’entrée (V)"
          }
        }
      ]
    }
  ]
